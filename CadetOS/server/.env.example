# Copy to .env and fill in (never commit .env)
OPENAI_API_KEY=sk-your-key-here

# Optional
PORT=3001
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Comma-separated origins allowed to call the API (add your production domain)
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Optional: require X-CADO-Secret on /api/* (server-side only — not shown on the website)
# CADETOS_API_SECRET=your-random-long-string

# Max chat requests per IP per 15 minutes
RATE_LIMIT_MAX=40

# Set to 1 when behind nginx/Cloudflare (accurate rate-limit IPs)
# TRUST_PROXY=1
